  {
   "who": "ai",
   "text": "Hello, is this Aptronix, Kukatpally?",
   "start": 0.0,
   "end": 3.55
  },
  {
   "who": "shop",
   "text": "\u0939\u093e\u0901 \u091c\u0940, Aptronix. \u092c\u094b\u0932\u093f\u090f\u0964",
   "start": 4.0,
   "end": 7.25
  },
  {
   "who": "ai",
   "text": "\u0928\u092e\u0938\u094d\u0924\u0947 \u091c\u0940\u0964 \u092e\u0948\u0902 \u090f\u0915 AI \u0905\u0938\u093f\u0938\u094d\u091f\u0947\u0902\u091f \u0939\u0942\u0901, \u090f\u0915 \u0917\u094d\u0930\u093e\u0939\u0915 \u0915\u0940 \u0924\u0930\u092b\u093c \u0938\u0947 \u0915\u0949\u0932 \u0939\u0948\u0964 \u0915\u094d\u092f\u093e \u0906\u092a\u0915\u0947 \u092a\u093e\u0938 iPhone 17, 256 GB, \u0932\u0948\u0935\u0947\u0902\u0921\u0930 \u0915\u0932\u0930 \u092e\u0947\u0902 \u0939\u0948?",
   "start": 7.7,
   "end": 19.7
  },
  {
   "who": "shop",
   "text": "\u0939\u093e\u0901 \u0938\u0930, \u090f\u0915 \u092a\u0940\u0938 \u0939\u0948\u0964",
   "start": 20.15,
   "end": 23.05
  },
  {
   "who": "ai",
   "text": "\u092b\u093c\u093e\u0907\u0928\u0932 \u092a\u094d\u0930\u093e\u0907\u0938 \u0915\u093f\u0924\u0928\u093e \u0939\u094b\u0917\u093e? \u0915\u094b\u0908 \u0915\u093e\u0930\u094d\u0921 \u0911\u092b\u093c\u0930 \u0939\u0948?",
   "start": 23.5,
   "end": 28.85
  },
  {
   "who": "shop",
   "text": "\u0909\u0928\u093e\u0938\u0940 \u0939\u091c\u093c\u093e\u0930 \u0928\u094c \u0938\u094c \u0939\u0948\u0964 ICICI \u0915\u093e\u0930\u094d\u0921 \u092a\u0947 \u091a\u093e\u0930 \u0939\u091c\u093c\u093e\u0930 \u0911\u092b\u093c, \u0924\u094b \u092a\u091a\u0939\u0924\u094d\u0924\u0930 \u0939\u091c\u093c\u093e\u0930 \u0928\u094c \u0938\u094c \u092b\u093c\u093e\u0907\u0928\u0932\u0964",
   "start": 29.3,
   "end": 37.6
  },
  {
   "who": "ai",
   "text": "ICICI \u0915\u093e\u0930\u094d\u0921 \u0938\u0947 \u092a\u091a\u0939\u0924\u094d\u0924\u0930 \u0939\u091c\u093c\u093e\u0930 \u0928\u094c \u0938\u094c\u0964 \u0915\u094d\u092f\u093e \u0906\u092a \u0936\u093e\u092e \u0924\u0915 \u0939\u094b\u0932\u094d\u0921 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902?",
   "start": 38.05,
   "end": 45.65
  },
  {
   "who": "shop",
   "text": "\u0939\u094b\u0932\u094d\u0921 \u0915\u093e \u092a\u0915\u094d\u0915\u093e \u0928\u0939\u0940\u0902 \u092c\u094b\u0932 \u0938\u0915\u0924\u093e \u0938\u0930, \u091c\u0932\u094d\u0926\u0940 \u0906 \u091c\u093e\u0907\u090f\u0964",
   "start": 46.1,
   "end": 50.05
  },
  {
   "who": "ai",
   "text": "\u0920\u0940\u0915 \u0939\u0948 \u091c\u0940, \u0927\u0928\u094d\u092f\u0935\u093e\u0926\u0964 \u0917\u094d\u0930\u093e\u0939\u0915 \u0915\u094b \u092c\u0924\u093e \u0926\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e\u0964",
   "start": 50.5,
   "end": 56.1
  },

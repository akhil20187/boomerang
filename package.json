{
  "name": "build-sprint-app",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "node --test voice-test/*.test.cjs call-bridge/*.test.cjs mcp/*.test.mjs web/src/errors.test.ts web/src/taskPresentation.test.ts web/src/statusPresentation.test.ts web/src/chatPresentation.test.ts web/src/callLogPresentation.test.ts web/src/signInPresentation.test.ts scripts/configure-development.test.mjs",
    "test:backend": "vitest run backend-tests",
    "typecheck": "tsc -p web/tsconfig.json && tsc -p convex/tsconfig.json",
    "dev": "vite --config web/vite.config.ts --host 127.0.0.1",
    "build": "vite build --config web/vite.config.ts && node mcp/build-widget.mjs",
    "preview": "vite preview --config web/vite.config.ts --host 127.0.0.1",
    "mcp": "node --env-file=.env.local mcp/server.mjs",
    "bridge": "node --env-file=.env --env-file-if-exists=.env.local call-bridge/bridge.cjs",
    "voice:test": "node --env-file=.env voice-test/server.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.96",
    "@convex-dev/static-hosting": "^0.2.1",
    "@convex-dev/workflow": "^0.4.8",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vitejs/plugin-react": "^6.1.1",
    "convex": "^1.46.0",
    "convex-test": "^0.0.60",
    "jose": "^6.2.12",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "ws": "^8.21.0"
  }
}
